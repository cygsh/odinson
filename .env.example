# Odinson gateway configuration — copy to `.env` and fill in your values.
# `.env` is gitignored. NEVER commit real tokens or ARNs.

# --- Serial / sensor ---
ODINSON_SERIAL_PORT=COM3          # Windows; e.g. /dev/ttyUSB0 on Linux
ODINSON_BAUD_RATE=115200
ODINSON_MOCK=false                # true = synthetic data, no hardware
ODINSON_DEVICE_ID=odinson-01

# --- Detection thresholds ---
ODINSON_ALERT_THRESHOLD=15        # delta above this => alert (sound + Telegram + SNS)
ODINSON_LOG_THRESHOLD=2           # delta above this => persisted
ODINSON_BASELINE_ALPHA=0.05
ODINSON_BUFFER_SIZE=200

# --- Local storage ---
ODINSON_DB_PATH=vibration_data.db
ODINSON_LOG_DIR=logs

# --- Web UI ---
ODINSON_HOST=0.0.0.0
ODINSON_PORT=5000

# --- Telegram alerts (token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AWS cloud bridge ---
ODINSON_AWS_ENABLED=false
ODINSON_AWS_REGION=ap-south-1
# ODINSON_AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack: emulate AWS locally
ODINSON_DYNAMODB_TABLE=odinson-readings
ODINSON_SNS_TOPIC_ARN=            # from CloudFormation stack output AlertsTopicArn
ODINSON_S3_BUCKET=                # from CloudFormation stack output LogBucketName
ODINSON_CLOUDWATCH_NAMESPACE=Odinson
ODINSON_CLOUD_PUBLISH_EVERY=20    # 1 cloud write/s at 20 Hz sampling — comfortably
                                  # inside the permanent DynamoDB free tier (25 WCU)
ODINSON_S3_ARCHIVE_INTERVAL_S=300

# Standard AWS SDK variables also work for credentials: AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_PROFILE, AWS_REGION ...
